{#
  Simple 20x20 line icons for the side navigation — drawn for this, not
  taken from any icon set or the inspiration screenshots. Always decorative
  (aria-hidden): every control that uses one carries its own text name.
#}
{% macro sideNavIcon(name, classes) %}
<svg class="app-side-nav-icon{% if classes %} {{ classes }}{% endif %}" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- if name == "home" -%}
    <path d="M3 9.5 10 3.5l7 6"/><path d="M5 8v8.5h10V8"/><path d="M8.25 16.5v-4.5h3.5v4.5"/>
  {%- elif name == "clock" -%}
    <circle cx="10" cy="10" r="7"/><path d="M10 6v4l2.75 1.75"/>
  {%- elif name == "save" -%}
    <path d="M3.5 12.5v3a1 1 0 0 0 1 1h11a1 1 0 0 0 1-1v-3"/><path d="M10 3.5v9"/><path d="m6.5 9 3.5 3.5L13.5 9"/>
  {%- elif name == "bookmark" -%}
    <path d="M5.5 3.5h9v13L10 13l-4.5 3.5z"/>
  {%- elif name == "bookmark-filled" -%}
    <path fill="currentColor" d="M5.5 3.5h9v13L10 13l-4.5 3.5z"/>
  {%- elif name == "hourglass" -%}
    <path d="M5.5 3.5h9"/><path d="M5.5 16.5h9"/><path d="M6.5 3.5c0 3.5 3.5 4.5 3.5 6.5s-3.5 3-3.5 6.5"/><path d="M13.5 3.5c0 3.5-3.5 4.5-3.5 6.5s3.5 3 3.5 6.5"/>
  {%- elif name == "upload" -%}
    <path d="M3.5 12.5v3a1 1 0 0 0 1 1h11a1 1 0 0 0 1-1v-3"/><path d="M10 12.5v-9"/><path d="M6.5 7 10 3.5 13.5 7"/>
  {%- elif name == "star" -%}
    <path d="m10 3 2.1 4.4 4.8.6-3.5 3.3.9 4.8L10 13.8l-4.3 2.3.9-4.8L3.1 8l4.8-.6z"/>
  {%- elif name == "star-filled" -%}
    <path fill="currentColor" d="m10 3 2.1 4.4 4.8.6-3.5 3.3.9 4.8L10 13.8l-4.3 2.3.9-4.8L3.1 8l4.8-.6z"/>
  {%- elif name == "hash" -%}
    <path d="M7.5 3.5 6 16.5"/><path d="M14 3.5l-1.5 13"/><path d="M3.5 7.5h13"/><path d="M3 12.5h13"/>
  {%- elif name == "id-card" -%}
    <rect x="2.5" y="4.5" width="15" height="11" rx="1.5"/><circle cx="7" cy="9" r="1.75"/><path d="M4.5 13c.5-1.25 1.4-2 2.5-2s2 .75 2.5 2"/><path d="M11.5 8.5h3.5"/><path d="M11.5 11.5h3.5"/>
  {%- elif name == "search" -%}
    <circle cx="8.75" cy="8.75" r="5.25"/><path d="m12.75 12.75 3.75 3.75"/>
  {%- elif name == "help" -%}
    <circle cx="10" cy="10" r="7"/><path d="M8 8a2 2 0 1 1 2.75 1.85c-.5.2-.75.6-.75 1.15v.5"/><path d="M10 14h.01"/>
  {%- elif name == "settings" -%}
    <path d="M3.5 6h8"/><path d="M14.5 6h2"/><circle cx="13" cy="6" r="1.5"/><path d="M3.5 14h2"/><path d="M8.5 14h8"/><circle cx="7" cy="14" r="1.5"/>
  {%- elif name == "sidebar" -%}
    <rect x="3" y="4" width="14" height="12" rx="1.5"/><path d="M8 4v12"/>
  {%- elif name == "collapse" -%}
    <path d="m11 6-4 4 4 4"/><path d="m15 6-4 4 4 4"/>
  {%- elif name == "expand" -%}
    <path d="m5 6 4 4-4 4"/><path d="m9 6 4 4-4 4"/>
  {%- elif name == "chevron-down" -%}
    <path d="m6 8 4 4 4-4"/>
  {%- elif name == "chevron-right" -%}
    <path d="m8 6 4 4-4 4"/>
  {%- elif name == "more" -%}
    <circle cx="5" cy="10" r=".9" fill="currentColor"/><circle cx="10" cy="10" r=".9" fill="currentColor"/><circle cx="15" cy="10" r=".9" fill="currentColor"/>
  {%- elif name == "plus" -%}
    <path d="M10 4.5v11"/><path d="M4.5 10h11"/>
  {%- elif name == "close" -%}
    <path d="m5.5 5.5 9 9"/><path d="m14.5 5.5-9 9"/>
  {%- endif -%}
</svg>
{%- endmacro %}
