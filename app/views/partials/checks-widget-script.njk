{#
  The checks-widget.njk script — kept separate so a page includes it once
  inside {% block pageScripts %} rather than inline with the markup.
#}
<script>
  (function () {
    var checksCell = document.querySelector('[data-checks-cell]')
    if (!checksCell) return

    var idleState = checksCell.querySelector('[data-checks-idle]')
    var runningState = checksCell.querySelector('[data-checks-running]')
    var completeState = checksCell.querySelector('[data-checks-complete]')
    var startButton = checksCell.querySelector('[data-start-checks-inline]')
    var countdownText = checksCell.querySelector('[data-checks-countdown]')
    var bar = checksCell.querySelector('[data-checks-bar]')
    var headline = checksCell.querySelector('[data-checks-headline]')
    var breakdown = checksCell.querySelector('[data-checks-breakdown]')
    var lastRun = checksCell.querySelector('[data-checks-last-run]')

    if (!startButton || !idleState || !runningState || !completeState) return

    var DURATION_SECONDS = 8

    function issueCount () {
      var stored = Number(checksCell.dataset.issueCount)
      if (!isNaN(stored) && stored >= 0) return stored
      return Math.floor(Math.random() * 20) + 1
    }

    function splitBySeverity (total) {
      if (total === 0) return { high: 0, medium: 0, low: 0 }

      var high = Math.min(total, Math.round(total * (0.1 + Math.random() * 0.15)))
      var medium = Math.min(total - high, Math.round(total * (0.3 + Math.random() * 0.2)))
      var low = total - high - medium

      return { high: high, medium: medium, low: low }
    }

    function setCountdown (secondsRemaining) {
      countdownText.textContent = 'Running checks — estimated time remaining: ' + secondsRemaining + ' second' + (secondsRemaining !== 1 ? 's' : '')
    }

    // Prototype-only memory of the last run, per page, in this browser.
    var STORAGE_KEY = 'checks-last-run:' + window.location.pathname

    function showLastRun (isoDate) {
      if (!lastRun || !isoDate) return
      var when = new Date(isoDate)
      lastRun.textContent = 'Last run: ' + when.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) +
        ' at ' + when.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' })
      lastRun.hidden = false
    }

    try { showLastRun(window.localStorage.getItem(STORAGE_KEY)) } catch (e) {}

    // The guide's real latest quality check, asked for when the run starts so
    // it is usually back by the time the pretend run ends. Resolves null when
    // there is none (or no href), and the widget makes its numbers up.
    function fetchRealCheck () {
      var href = checksCell.dataset.qualityCheckHref
      if (!href || !window.fetch) return Promise.resolve(null)
      return window.fetch(href, { headers: { Accept: 'application/json' } })
        .then(function (response) { return response.ok ? response.json() : null })
        .catch(function () { return null })
    }

    function showResult (total, severity) {
      headline.textContent = total === 0 ? 'No issues found' : total + ' issue' + (total !== 1 ? 's' : '') + ' found'
      breakdown.hidden = !severity
      breakdown.textContent = severity
        ? severity.high + ' high priority, ' + severity.medium + ' medium priority, ' + severity.low + ' low priority'
        : ''
      runningState.hidden = true
      completeState.hidden = false
    }

    // With a real check, "View issues" shows its comments on the guide
    // (guide-comments.js) rather than the made-up issues page, where the
    // page has them.
    var viewIssues = completeState.querySelector('a.govuk-button')
    var commentsShown = false

    function showCommentsFrom (link) {
      if (!link || commentsShown || !document.querySelector('[data-guide-comments]')) return
      commentsShown = true
      link.addEventListener('click', function (event) {
        event.preventDefault()
        document.dispatchEvent(new CustomEvent('app:show-guide-comments'))
      })
    }

    startButton.addEventListener('click', function () {
      var realCheck = fetchRealCheck()
      idleState.hidden = true
      completeState.hidden = true
      runningState.hidden = false

      var remaining = DURATION_SECONDS
      setCountdown(remaining)

      bar.style.transitionDuration = '0s'
      bar.style.width = '0%'
      window.setTimeout(function () {
        bar.style.transitionDuration = DURATION_SECONDS + 's'
        bar.style.width = '100%'
      }, 0)

      var tick = window.setInterval(function () {
        remaining = Math.max(remaining - 1, 0)
        setCountdown(remaining)
      }, 1000)

      window.setTimeout(function () {
        window.clearInterval(tick)

        realCheck.then(function (check) {
          // A real check has no severities, so it shows no breakdown, and
          // its last run is when it really ran.
          if (check) {
            showResult(check.issueCount, null)
            showLastRun(check.lastRun)
            showCommentsFrom(viewIssues)
            return
          }

          var total = issueCount()
          showResult(total, splitBySeverity(total))

          var now = new Date().toISOString()
          showLastRun(now)
          try { window.localStorage.setItem(STORAGE_KEY, now) } catch (e) {}
        })
      }, DURATION_SECONDS * 1000)
    })
  })()
</script>
