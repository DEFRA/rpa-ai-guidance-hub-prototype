{#
  Notes: a designer/dev annotation panel, inspired by "Alan" in
  defra-design/fcp-farming-front-door. Shows whatever this page's
  `*.notes.json` file says (see app/lib/page-notes.js) — status, the intended
  designer URL slug (which may not match this prototype's own route — see
  CLAUDE.md), and a running list of comments left by whoever has worked on
  the page.

  There's no way to add a note from the browser: edit the page's
  `*.notes.json` file (next to its template) and commit it, same as any other
  change to the prototype.
#}
<div class="app-notes-panel" id="app-notes-panel">
  <div class="app-notes-panel__header">
    <h2 class="app-notes-panel__title">Notes</h2>
    <button type="button" class="app-notes-panel__close" onclick="toggleNotesPanel()">
      <span class="govuk-visually-hidden">Close</span>&times;
    </button>
  </div>

  <div class="app-notes-panel__body">
    {% if pageNotes %}
      {% if pageNotes.url %}
        <p class="app-notes-panel__url">
          URL slug: <code>{{ pageNotes.url }}</code>
        </p>
      {% endif %}

      {% if pageNotes.status %}
        <p class="app-notes-panel__status">
          <strong class="govuk-tag">{{ pageNotes.status }}</strong>
        </p>
      {% endif %}

      {% if pageNotes.notes and pageNotes.notes.length %}
        <ul class="app-notes-panel__list">
          {% for note in pageNotes.notes %}
            <li class="app-notes-panel__note">
              <p class="app-notes-panel__note-meta">
                {% if note.author %}<strong>{{ note.author }}</strong>{% endif %}
                {% if note.date %}<span>{{ note.date }}</span>{% endif %}
              </p>
              <p class="app-notes-panel__note-text">{{ note.text }}</p>
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <p class="govuk-body-s">No notes for this page yet.</p>
      {% endif %}
    {% else %}
      <p class="govuk-body-s">
        No notes for this page yet. Add a <code>page.notes.json</code>
        (or <code>&lt;template&gt;.notes.json</code>) file alongside its
        template to leave one.
      </p>
    {% endif %}
  </div>
</div>
