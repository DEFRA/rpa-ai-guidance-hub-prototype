{#
  A genuine single-page A/B against the stepper viewer
  (stepper.njk, alongside this page) — the same document content (sections is
  built by controller.js's buildTraditionalSections, one consistent
  {id, heading, body}[] shape regardless of whether the source document
  has nested steps, flat steps, or falls back to the generic 3-phase
  placeholder content), laid out continuously on one page rather than
  shown one step at a time.

  Previously this route rendered fixed severity/issues content instead —
  not a document viewer at all, just an unlabelled duplicate of
  /playground/issues' own Issues/Findings layout (a mistake this
  inherited from the v6 pages it was ported from — see controller.js's own
  comment, and page.notes.md, for the full history). This rewrite is the
  first time "Traditional viewer" actually shows the guidance text.

  Deliberately leaner than the stepper, not a feature-for-feature clone of
  it: no search box, no Case notes tab, no collapsible content panel — a
  continuous read is the point of a "traditional" layout, and duplicating
  every stepper control here would just make this a worse stepper rather
  than a genuinely different way to read the same guidance. The one piece
  carried over is a simple in-page contents list, reusing stepper.njk's own
  .app-document-content__nav/-nav-item/-nav-link classes (_app-saved-
  document.scss) since the visual language already fits — each link here
  just jumps to an on-page #anchor instead of swapping a hidden step.

  Body rendering (paragraph vs bullet list vs the fixed CASE_NOTE_BLOCK
  placeholder) is copied verbatim from stepper.njk's own currentStep.body
  loop — same three entry shapes, same renderLinkMarkers filter for
  {{LINK:label}} markers — so a document with a real CASE_NOTE_BLOCK entry
  (see app/data/guidance-documents.js) reads identically on both viewers.
#}
{% extends "layouts/main.html" %}

{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "govuk/components/breadcrumbs/macro.njk" import govukBreadcrumbs %}

{% set versionTags = {
  "Version 1": { text: "Version 1", classes: "govuk-tag--green" },
  "Version 2": { text: "Version 2", classes: "govuk-tag--purple" }
} %}

{% set pageName = documentName %}

{% block content %}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-full">
    {{ govukBreadcrumbs({
      classes: "govuk-!-margin-bottom-6",
      items: [
        { text: "Home", href: "/playground/hub" },
        { text: documentName }
      ]
    }) }}
  </div>
</div>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-one-quarter"></div>
  <div class="govuk-grid-column-three-quarters">

    <div class="govuk-!-margin-bottom-4">
      {{ govukTag(versionTags[version]) }}
    </div>

    <span class="govuk-caption-m">Title</span>
    <h1 class="govuk-heading-m">{{ documentName }}</h1>

  </div>
</div>

<div class="govuk-grid-row">

  <div class="govuk-grid-column-one-quarter">
    <nav aria-label="Contents">
      <ul class="app-document-content__nav">
        {% for section in sections %}
          <li class="app-document-content__nav-item">
            <a class="app-document-content__nav-link" href="#{{ section.id }}">{{ section.heading }}</a>
          </li>
        {% endfor %}
      </ul>
    </nav>
  </div>

  <div class="govuk-grid-column-three-quarters">
    {% for section in sections %}
      <h2 class="govuk-heading-m" id="{{ section.id }}">{{ section.heading }}</h2>
      {% for entry in section.body %}
        {% if entry == "CASE_NOTE_BLOCK" %}
          <div class="app-case-note">
            <p class="govuk-body">Is the option being checked <span style="color: #d4351c">AB5</span> against the <span style="color: #d4351c">Historical layer and Moorland</span>?</p>
            <p class="govuk-body">If "Yes" cross check the options map (found on CRM) with the HEFER/FER to ensure the option is eligible. If the options map is unavailable, request an updated options map that confirms the <span style="color: #d4351c">AB5</span> location for the current revenue claim year from the Agreement Holder.</p>
            <p class="govuk-body">If "No" continue</p>
            <p class="govuk-body">Have other options been identified that relate to other checks not mentioned above?</p>
            <ul class="govuk-list govuk-list--bullet">
              <li>If 'No', go to section 4.2 Close Case.</li>
              <li>If 'Yes', continue to section 3 Work the anomaly</li>
            </ul>
          </div>
          <p class="govuk-body-s app-case-note__caption">Replace the highlighted text with the case-specific details, then format to black before saving.</p>
        {% elif entry is string %}
          <p class="govuk-body">{{ entry | renderLinkMarkers }}</p>
        {% else %}
          <ul class="govuk-list govuk-list--bullet">
            {% for item in entry %}
              <li>{{ item | renderLinkMarkers }}</li>
            {% endfor %}
          </ul>
        {% endif %}
      {% endfor %}
      {% if not loop.last %}
        <hr class="govuk-section-break govuk-section-break--visible govuk-section-break--m">
      {% endif %}
    {% endfor %}
  </div>

</div>

{% endblock %}
