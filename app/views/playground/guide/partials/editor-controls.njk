{#
  Editor tools — one status card (what is live, whether there are unpublished
  edits) with the next action under it, then publishing checks in their own panel. Only included
  when `isEditor` is true. Reads `editorActions` (playground/guide/view-model.js).
  There is no branching, so the draft is just "unpublished edits" on the live
  version, not a status to label.
#}
{% from "govuk/components/button/macro.njk" import govukButton %}

<div class="app-editor-panel">
  <p class="govuk-body govuk-!-font-weight-bold govuk-!-margin-bottom-1">{{ editorActions.liveText }}</p>
  {% if editorActions.draft %}
    <p class="govuk-body govuk-!-margin-bottom-1">{{ editorActions.draft.statusText }}</p>
    {% if editorActions.draft.changesRequestedText %}
      <p class="govuk-body-s govuk-!-margin-bottom-1">{{ editorActions.draft.changesRequestedText }}</p>
    {% endif %}
  {% endif %}

  <div class="govuk-button-group govuk-!-margin-top-3 govuk-!-margin-bottom-0">
    {% if editorActions.continueEditingHref %}
      {{ govukButton({
        text: "Continue editing",
        href: editorActions.continueEditingHref,
        classes: "govuk-!-margin-bottom-0"
      }) }}
    {% endif %}
    {% if editorActions.startEditingHref %}
      <form method="post" action="{{ editorActions.startEditingHref }}">
        {{ govukButton({ text: "Edit this guide", classes: "govuk-!-margin-bottom-0" }) }}
      </form>
    {% endif %}
    {% if editorActions.approveHref %}
      <form method="post" action="{{ editorActions.approveHref }}">
        {{ govukButton({
          text: "Approve as " + editorActions.nextVersionLabel,
          classes: "govuk-!-margin-bottom-0"
        }) }}
      </form>
      <form method="post" action="{{ editorActions.requestChangesHref }}">
        {{ govukButton({
          text: "Request changes",
          classes: "govuk-button--secondary govuk-!-margin-bottom-0"
        }) }}
      </form>
    {% endif %}
  </div>
</div>

<div class="app-editor-panel govuk-!-margin-top-4">
  <h3 class="govuk-heading-s govuk-!-margin-bottom-2">Publishing checks</h3>
  {% set publishingChecks = editorActions.publishingChecks %}
  {% set issuesHref = editorActions.issuesHref %}
  {% include "partials/checks-widget.njk" %}
</div>
