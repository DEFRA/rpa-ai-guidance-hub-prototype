{#
  Editor-only controls — status, publishing checks, change history,
  edit/continue editing — folded inline here instead of gating them
  behind the old separate document overview page. Only ever included when
  `isEditor` is true (each direction checks that before including this).
  Reads `editorActions` (playground/guide/view-model.js).
#}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/details/macro.njk" import govukDetails %}

{% set statusTags = {
  "Published": { text: "Published", classes: "govuk-tag--green" },
  "Draft": { text: "Draft", classes: "govuk-tag--grey" },
  "Awaiting approval": { text: "Awaiting approval", classes: "govuk-tag--yellow" }
} %}

{{ govukTag(statusTags[editorActions.status]) }}

{% if editorActions.status != "Published" %}
  <h3 class="govuk-heading-s govuk-!-margin-top-4 govuk-!-margin-bottom-1">Publishing checks</h3>
  {% set publishingChecks = editorActions.publishingChecks %}
  {% set issuesHref = editorActions.issuesHref %}
  {% include "partials/checks-widget.njk" %}

  <p class="govuk-body govuk-!-margin-top-4 govuk-!-margin-bottom-0">
    <strong>Changes requested:</strong>
    {{ editorActions.changesRequested if editorActions.changesRequested else "None" }}
  </p>
{% endif %}

{% call govukDetails({ summaryText: "Change history", classes: "govuk-!-margin-top-4" }) %}
  <ul class="govuk-list">
    {% for version in editorActions.changeHistory %}
      <li><strong>{{ version.label }}:</strong> {{ version.versionNotes }} — {{ version.lastUpdated }}</li>
    {% endfor %}
  </ul>
{% endcall %}

<div class="govuk-button-group govuk-!-margin-top-2">
  {% if editorActions.continueEditingHref %}
    {{ govukButton({
      text: "Continue editing",
      href: editorActions.continueEditingHref,
      classes: "govuk-button--secondary govuk-!-margin-bottom-0"
    }) }}
  {% endif %}
  {% if editorActions.startEditingHref %}
    <form method="post" action="{{ editorActions.startEditingHref }}">
      {{ govukButton({
        text: "Edit",
        classes: "govuk-button--secondary govuk-!-margin-bottom-0"
      }) }}
    </form>
  {% endif %}
</div>
