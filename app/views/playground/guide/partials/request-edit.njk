{#
  A viewer cannot edit a guide unless a designer gives them temporary
  delegated approval — this asks for it. In the guide's byline, beside Pin
  guide: the button, or once asked, what happens next. Reads
  `editRequested`, `requestEditHref` (playground/guide/view-model.js).
#}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% if editRequested %}
  <span class="app-guide-byline__request-edit"><strong>Edit permission requested.</strong> A designer needs to approve it before you can edit this guide.</span>
{% else %}
  <form class="app-guide-byline__request-edit" method="post" action="{{ requestEditHref }}">
    {{ govukButton({
      text: "Request permission to edit",
      classes: "govuk-button--secondary govuk-!-margin-bottom-0"
    }) }}
  </form>
{% endif %}
