{#
  The merged guide page — settled on the side-panel direction after
  comparing it against a top-toolbar and an inline layout (see
  page.notes.md). Reading column plus a persistent right-hand panel
  holding case bookmarks, the reader-facing metadata (metadata-list.njk)
  and, for a designer only, an "Editor tools" section (editor-controls.njk)
  — version switching, publishing checks and Continue editing sit
  alongside the guide rather than gating it behind a separate screen,
  without costing a viewer a click.

  The panel is a third column in the side-nav shell itself
  (layouts/main.html's shellAside block), not part of this page's own
  content column — a mirror image of .app-shell__nav (same full-height,
  sticky, flush-right column; _app-guide.scss reuses its tokens). Without
  the shell (sideNav unset — a future frozen snapshot), the same markup
  renders inline instead, stacked below the reading column, so a snapshot
  never silently loses it.
#}
{% extends "common/layouts/base.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "partials/side-nav-icon.njk" import sideNavIcon %}

{% set bodyClasses = "app-full-width" %}
{% set pageName = document.name %}

{% set guidePanel %}
  <form id="guide-panel-toggle-form" method="post" action="{{ panelToggleHref }}" hidden>
    <input type="hidden" name="collapsed" value="{{ 'false' if panelCollapsed else 'true' }}">
    <input type="hidden" name="returnTo" value="{{ returnTo }}">
  </form>

  {% if not panelCollapsed %}
    {#
      Drag/arrow-key resize handle, [hidden] until side-nav.js attaches
      (its own setupResize, shared with the nav's own handle below) —
      without JS the native corner grip (_app-guide.scss's `resize:
      horizontal`) still works. Sits before the aside, mirroring the nav's
      own handle sitting before .app-shell__main in layouts/main.html —
      side-nav.js drags it in the opposite direction (this edge is the
      panel's left, not its right).
    #}
    <div class="app-shell__resize app-shell__resize--aside" role="separator" aria-orientation="vertical"
         aria-label="Resize guide details" aria-controls="guide-panel-body"
         aria-valuemin="{{ panelWidthLimits.min }}" aria-valuemax="{{ panelWidthLimits.max }}"
         data-guide-panel-resize data-width-href="{{ panelWidthHref }}" tabindex="0" hidden></div>
  {% endif %}

  <aside class="app-guide-panel{% if panelCollapsed %} app-guide-panel--collapsed{% endif %}" aria-label="About this guide"{% if panelWidth and not panelCollapsed %} style="--app-guide-panel-width: {{ panelWidth }}px"{% endif %}>
    {% if panelCollapsed %}
      {#
        The collapsed rail — the side nav's own rail component
        (partials/side-nav-rail.njk, _app-side-nav.scss) reused directly
        rather than a single full-width button, so there's a jump straight
        to Case bookmarks as well as a plain expand (crit: unreachable when
        collapsed). Both submit guide-panel-toggle-form; the bookmarks item
        overrides its returnTo with a #fragment the same way the nav
        rail's own railExpand does (panel-toggle/routes.js's own
        [].concat(...).pop()).
      #}
      <nav class="app-side-nav app-side-nav--rail" aria-label="About this guide">
        <ul class="app-side-nav__rail-list">
          <li>
            <button type="submit" form="guide-panel-toggle-form" class="app-side-nav__rail-item" data-side-nav-tooltip>
              {{ sideNavIcon("collapse") }}
              <span class="app-side-nav__rail-label">Show guide details</span>
              <span class="app-side-nav__tooltip" aria-hidden="true">Show guide details</span>
            </button>
          </li>
          <li>
            <button type="submit" form="guide-panel-toggle-form" name="returnTo" value="{{ returnTo.split('#')[0] }}#guide-case-bookmarks" class="app-side-nav__rail-item" data-side-nav-tooltip>
              {{ sideNavIcon("bookmark") }}
              <span class="app-side-nav__rail-label">Case bookmarks</span>
              <span class="app-side-nav__tooltip" aria-hidden="true">Case bookmarks</span>
            </button>
          </li>
        </ul>
      </nav>
    {% else %}
      <div class="app-guide-panel__header">
        <h2 class="govuk-heading-s govuk-!-margin-bottom-0">About this guide</h2>
        <button type="submit" form="guide-panel-toggle-form" class="app-side-nav__icon-button" aria-controls="guide-panel-body">
          {{ sideNavIcon("expand") }}
          <span class="govuk-visually-hidden">Hide guide details</span>
        </button>
      </div>

      <div class="app-guide-panel__body" id="guide-panel-body">
        {% include "playground/guide/partials/case-bookmarks.njk" %}


        {% include "playground/guide/partials/metadata-list.njk" %}

        {% include "playground/guide/partials/versions.njk" %}

        {% if canRequestEdit %}
          {% include "playground/guide/partials/request-edit.njk" %}
        {% endif %}

        {% if isEditor %}
          <h2 class="govuk-heading-s govuk-!-margin-top-6">Editor tools</h2>
          {% include "playground/guide/partials/editor-controls.njk" %}
        {% endif %}
      </div>
    {% endif %}
  </aside>

  {#
    The quality check comments, Word style (guide-comments.js): in the
    panel's place while open, opened by the checks widget's "View issues"
    once the guide has a real check.
  #}
  {% if isEditor and editorActions.qualityCheckHref %}
    <aside class="app-guide-comments" aria-label="Quality check comments" data-guide-comments data-quality-check-href="{{ editorActions.qualityCheckHref }}" hidden>
      <div class="app-guide-panel__header">
        <h2 class="govuk-heading-s govuk-!-margin-bottom-0">Quality check comments</h2>
        <button type="button" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-guide-comments-close>Close comments</button>
      </div>
      <div data-guide-comments-unplaced></div>
      <div class="app-guide-comments__track" data-guide-comments-track></div>
    </aside>
  {% endif %}
{% endset %}

{% block content %}

<div class="app-guide-reading app-guide-reading--{{ readingWidth }}"{% if positionHref %} data-guide-position-href="{{ positionHref }}"{% endif %}>

  {% if bookmarkSuccess %}
    {% call govukNotificationBanner({ type: "success" }) %}
      <h3 class="govuk-notification-banner__heading">{{ bookmarkSuccess.text }}</h3>
      <p class="govuk-body"><a class="govuk-notification-banner__link" href="{{ bookmarkSuccess.href }}">View all guides for this case</a></p>
    {% endcall %}
  {% endif %}

  {% if isOlderVersion %}
    {% call govukNotificationBanner({ titleText: "Earlier version" }) %}
      <p class="govuk-notification-banner__heading">This is {{ version }}, an earlier version of this guide.</p>
      <p class="govuk-body"><a class="govuk-notification-banner__link" href="{{ currentVersionHref }}">View the current version</a></p>
    {% endcall %}
  {% endif %}

  <div class="app-guide-byline">
    {% if versionTag %}{{ govukTag(versionTag) }}{% endif %}
    {% if versionTag or isApiGuide %}{{ govukTag({ text: "Live", classes: "govuk-tag--turquoise" }) }}{% endif %}
    <span class="app-guide-byline__updated">Updated {{ currentVersion.lastUpdated }}</span>
    {% set pinDocumentId = document.id %}
    {% include "partials/pin-button.njk" %}
  </div>

  <h1 class="app-guide-title">{{ document.name }}</h1>

  {% if readingWidthChoice %}
    <div class="app-guide-tools">
      {% include "playground/guide/partials/reading-width.njk" %}
    </div>
  {% endif %}


  {#
    The guide's own tools, at the top of its contents column
    (reading-content.njk, or the contents list below for a guide without
    sections): the format toggle, then keyword search in this guide
    (guide-keyword-search.js). Ctrl+F comes to the search box; opened with
    ?keywords= (a hub result), it searches for them at once. The column
    stays in view as the reader scrolls.
  #}
  {% set guideTools %}
    {% if formatHrefs %}
      {% include "playground/guide/partials/format-toggle.njk" %}
    {% endif %}
    <form class="app-guide-keyword-search" role="search" data-guide-keyword-search>
      <div class="app-guide-keyword-search__bar">
        {{ govukInput({
          id: "guide-keywords",
          name: "keywords",
          type: "search",
          value: keywords,
          label: {
            text: "Search this guide",
            classes: "govuk-visually-hidden"
          },
          attributes: {
            placeholder: "Search this guide",
            autocomplete: "off"
          },
          formGroup: { classes: "app-guide-keyword-search__field" }
        }) }}
        {{ govukButton({ text: "Search", classes: "govuk-visually-hidden-focusable app-guide-keyword-search__button" }) }}
      </div>
      {#
        Once searched: how many matches, and in how many sections; then, if
        there are any, Previous and Next (Shift+Enter and Enter in the box)
        and which match is shown (guide-keyword-search.js).
      #}
      <div class="app-guide-keyword-search__results" data-guide-keyword-search-results hidden>
        <p class="govuk-body-s govuk-!-font-weight-bold app-guide-keyword-search__status" role="status" data-guide-keyword-search-status></p>
        <div class="app-guide-keyword-search__controls" data-guide-keyword-search-controls hidden>
          <button type="button" class="govuk-button govuk-button--secondary app-guide-keyword-search__step" data-module="govuk-button" data-guide-keyword-search-step="previous" aria-keyshortcuts="Shift+Enter">&lsaquo; Previous</button>
          <button type="button" class="govuk-button govuk-button--secondary app-guide-keyword-search__step" data-module="govuk-button" data-guide-keyword-search-step="next" aria-keyshortcuts="Enter">Next &rsaquo;</button>
          <span class="govuk-body-s app-guide-keyword-search__position" aria-live="polite" data-guide-keyword-search-position></span>
        </div>
      </div>
    </form>
  {% endset %}

  <div class="app-guide-columns">

  {#
    Resume reading: where this reader last was (saved as they scroll by
    guide-position.js), offered on a fresh visit rather than jumped to, so
    opening a guide stays predictable. The script hides it when the URL
    already points somewhere (#anchor).
  #}
  {% if resume %}
    <div class="govuk-inset-text app-guide-resume" data-guide-resume>
      You were last reading <strong>{{ resume.label }}</strong>.
      <a class="govuk-link" href="{{ resume.href }}">Continue reading<span class="govuk-visually-hidden"> from {{ resume.label }}</span></a>
    </div>
  {% endif %}

  {% if isApiGuide and not content.sections %}
    {#
      An API guide with no headings to split on has no
      sections/parts/stepper model to walk — content.html is the whole
      guide, already rendered from its content.md by marked
      (guide/guide-content.js's buildMarkdownGuideContent), so it's just
      dropped in directly rather than through reading-content.njk's
      section/part/pagination markup.
    #}
    {% if content.contents.length %}
      <nav class="app-guide-contents" aria-labelledby="guide-contents-heading" data-guide-toc>
        {{ guideTools | safe }}
        <h2 class="govuk-heading-s" id="guide-contents-heading">Contents</h2>
        <ul class="govuk-list app-guide-contents__list app-guide-contents__list--flat">
          {% for heading in content.contents %}
            <li class="app-guide-contents__item--depth-{{ heading.depth }}"><a class="govuk-link app-guide-contents__link" href="#{{ heading.id }}" data-guide-toc-target="{{ heading.id }}">{{ heading.text }}</a></li>
          {% endfor %}
        </ul>
      </nav>
    {% else %}
      {# No contents column to hold them: the tools sit above the guide. #}
      <div class="app-guide-tools-inline">{{ guideTools | safe }}</div>
    {% endif %}
    <div class="app-guide-markdown">{{ content.html | safe }}</div>
  {% else %}
    {% include "playground/guide/partials/reading-content.njk" %}
  {% endif %}

  </div>

</div>

{% if not sideNav %}{{ guidePanel | safe }}{% endif %}

{% endblock %}

{% block shellAside %}{% if sideNav %}{{ guidePanel | safe }}{% endif %}{% endblock %}

{% block pageScripts %}
  {% include "partials/checks-widget-script.njk" %}
  {% if isMarkdown %}<script src="/public/javascripts/vendor/tiptap-viewer.js"></script>{% endif %}
  {% if isMarkdown %}<script src="/public/javascripts/guide-links.js"></script>{% endif %}
  <script src="/public/javascripts/guide-images.js"></script>
  {% if stepperPages %}<script src="/public/javascripts/guide-pages.js"></script>{% endif %}
  <script src="/public/javascripts/keyword-matches.js"></script>
  <script src="/public/javascripts/guide-keyword-search.js"></script>
  {# Marks the one contents entry for where the reader is, or the current match. #}
  <script src="/public/javascripts/guide-toc.js"></script>
  {% if positionHref %}<script src="/public/javascripts/guide-position.js"></script>{% endif %}
  {% if isEditor and editorActions.qualityCheckHref %}<script src="/public/javascripts/guide-comments.js"></script>{% endif %}
{% endblock %}
