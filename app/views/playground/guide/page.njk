{#
  The merged guide page: the reading column on its own. There is no
  "About this guide" panel any more: editing and publishing checks are in
  the side nav's Designing group (sideNavPageItems, below), and the guide's
  metadata (who it's for, scheme, systems, owner, purpose, required
  knowledge) is in the information panel the title's info button opens, as
  well as on its hub result (playground/hub/page.njk).

  The quality check comments (guideComments, below) are a third column in
  the side-nav shell itself (layouts/main.html's shellAside block) while
  open. Without the shell (sideNav unset — a future frozen snapshot), the
  same markup renders inline instead, stacked below the reading column.
#}
{% extends "common/layouts/base.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "govuk/components/phase-banner/macro.njk" import govukPhaseBanner %}
{% from "partials/side-nav-icon.njk" import sideNavIcon %}

{% set bodyClasses = "app-full-width" %}
{% set pageName = document.name %}

{#
  Edit this guide, then Start publishing checks, last in the side nav's
  Designing group (designers only; partials/side-nav.njk). Edit starts a
  draft, or opens the one in progress. Start publishing checks runs the
  checks and shows them (guide-publishing-checks.js).
#}
{% set sideNavPageItems = [] %}
{% if sideNav.designerItems.length and editorActions %}
  {% if editorActions.startEditingHref %}
    {% set pushed = sideNavPageItems.push({ text: "Edit this guide", icon: "edit", action: editorActions.startEditingHref }) %}
  {% elif editorActions.continueEditingHref %}
    {% set pushed = sideNavPageItems.push({ text: "Edit this guide", icon: "edit", href: editorActions.continueEditingHref }) %}
  {% endif %}
  {% set pushed = sideNavPageItems.push({
    text: "Start publishing checks",
    icon: "microscope",
    attributes: {
      "data-start-checks": "",
      "data-issue-count": editorActions.publishingChecks,
      "data-quality-check-href": editorActions.qualityCheckHref,
      "data-issues-href": editorActions.issuesHref
    },
    status: { text: "Checks not run", data: "data-checks-nav-status" }
  }) %}
  {% set publishingChecksInNav = true %}
{% endif %}

{% set guideComments %}
  {#
    The quality check comments, Word style (guide-comments.js): a
    right-hand column while open, opened by the side nav's Show publishing
    checks (guide-publishing-checks.js) once the guide has a real check.
  #}
  {% if isEditor and editorActions.qualityCheckHref %}
    <aside class="app-guide-comments" aria-label="Quality check comments" data-guide-comments data-quality-check-href="{{ editorActions.qualityCheckHref }}" hidden>
      <div class="app-guide-panel__header">
        <h2 class="govuk-body-s govuk-!-font-weight-bold govuk-!-margin-bottom-0">Quality check comments</h2>
        <button type="button" class="app-side-nav__icon-button" data-guide-comments-close>
          {{ sideNavIcon("close") }}
          <span class="govuk-visually-hidden">Close comments</span>
        </button>
      </div>
      <div data-guide-comments-unplaced></div>
      <div class="app-guide-comments__track" data-guide-comments-track></div>
    </aside>
  {% endif %}
{% endset %}

{#
  The phase banner normally renders in beforeContent, above everything; on a
  guide it heads the reading column instead (below), so the contents column
  starts at the top of the page.
#}
{% block beforeContent %}{% endblock %}

{% block content %}

<div class="app-guide-reading app-guide-reading--{{ readingWidth }}"{% if positionHref %} data-guide-position-href="{{ positionHref }}"{% endif %}>

  {% if bookmarkSuccess %}
    {% call govukNotificationBanner({ type: "success" }) %}
      <h3 class="govuk-notification-banner__heading">{{ bookmarkSuccess.text }}</h3>
      <p class="govuk-body"><a class="govuk-notification-banner__link" href="{{ bookmarkSuccess.href }}">View all guides for this case</a></p>
    {% endcall %}
  {% endif %}

  {% if isOlderVersion %}
    {% call govukNotificationBanner({ titleText: "Earlier version" }) %}
      <p class="govuk-notification-banner__heading">This is {{ version }}, an earlier version of this guide.</p>
      <p class="govuk-body"><a class="govuk-notification-banner__link" href="{{ currentVersionHref }}">View the current version</a></p>
    {% endcall %}
  {% endif %}

  {#
    The guide's own tools, at the top of its contents column
    (reading-content.njk, or the contents list below for a guide without
    sections): the format toggle, then keyword search in this guide
    (guide-keyword-search.js). Ctrl+F comes to the search box; opened with
    ?keywords= (a hub result), it searches for them at once. The column
    stays in view as the reader scrolls.
  #}
  {% set guideTools %}
    {% if formatHrefs %}
      {% include "playground/guide/partials/format-toggle.njk" %}
    {% endif %}
    <form class="app-guide-keyword-search" role="search" data-guide-keyword-search>
      <div class="app-guide-keyword-search__bar">
        {{ govukInput({
          id: "guide-keywords",
          name: "keywords",
          type: "search",
          value: keywords,
          label: {
            text: "Search this guide",
            classes: "govuk-visually-hidden"
          },
          attributes: {
            placeholder: "Search this guide",
            autocomplete: "off"
          },
          formGroup: { classes: "app-guide-keyword-search__field" }
        }) }}
        {{ govukButton({ text: "Search", classes: "govuk-visually-hidden-focusable app-guide-keyword-search__button" }) }}
      </div>
      {#
        Once searched: how many matches, and in how many sections; then, if
        there are any, Previous and Next (Shift+Enter and Enter in the box)
        and which match is shown (guide-keyword-search.js).
      #}
      <div class="app-guide-keyword-search__results" data-guide-keyword-search-results hidden>
        <p class="govuk-body-s govuk-!-font-weight-bold app-guide-keyword-search__status" role="status" data-guide-keyword-search-status></p>
        <div class="app-guide-keyword-search__controls" data-guide-keyword-search-controls hidden>
          <button type="button" class="govuk-button govuk-button--secondary app-guide-keyword-search__step" data-module="govuk-button" data-guide-keyword-search-step="previous" aria-keyshortcuts="Shift+Enter">&lsaquo; Previous</button>
          <button type="button" class="govuk-button govuk-button--secondary app-guide-keyword-search__step" data-module="govuk-button" data-guide-keyword-search-step="next" aria-keyshortcuts="Enter">Next &rsaquo;</button>
          <span class="govuk-body-s app-guide-keyword-search__position" aria-live="polite" data-guide-keyword-search-position></span>
        </div>
      </div>
    </form>
  {% endset %}

  <div class="app-guide-columns"{% if contentsWidth %} style="--app-guide-toc-width: {{ contentsWidth }}px"{% endif %}>

  {#
    Drag/arrow-key resize handle on the Contents column's right-hand edge,
    as the side nav has (side-nav.js), [hidden] until that attaches. Wide
    screens only: narrower, the contents sit above the guide.
  #}
  <div class="app-shell__resize app-guide-contents-resize" role="separator" aria-orientation="vertical"
       aria-label="Resize contents" aria-controls="guide-contents"
       aria-valuemin="{{ contentsWidthLimits.min }}" aria-valuemax="{{ contentsWidthLimits.max }}"
       data-guide-contents-resize data-width-href="{{ contentsWidthHref }}" tabindex="0" hidden></div>

  {#
    The phase banner and the guide's heading (byline, title and width
    choice) head the reading column, so the contents column starts at the
    top of the page.
  #}
  {{ govukPhaseBanner({
    tag: { text: "Prototype" },
    text: "This is a prototype for user research. Nothing you enter is saved."
  }) }}

  <div class="app-guide-byline">
    {% if versionTag %}{{ govukTag(versionTag) }}{% endif %}
    {% if versionTag or isApiGuide %}{{ govukTag({ text: "Live", classes: "govuk-tag--turquoise" }) }}{% endif %}
    <span class="app-guide-byline__updated">Updated {{ currentVersion.lastUpdated }}</span>
    {% set pinDocumentId = document.id %}
    {% include "partials/pin-button.njk" %}
    {% if canRequestEdit %}
      {% include "playground/guide/partials/request-edit.njk" %}
    {% endif %}
  </div>

  {#
    The guide's information: its metadata, named and in the order of the
    upload journey's check answers page, in a grey panel under the title.
    Not the title or the version: both are just above.
    The info button beside the title opens and closes it (guide-info.js).
    The panel starts closed in the page itself, so it doesn't show and then
    vanish as the page loads.
  #}
  <div class="app-guide-title-row">
    <h1 class="app-guide-title">{{ document.name }}</h1>
    <button type="button" class="app-guide-info-toggle" aria-expanded="false" aria-controls="guide-info" data-guide-info-toggle>
      {{ sideNavIcon("info") }}
      <span class="govuk-visually-hidden">Guide information</span>
      <span class="app-side-nav__tooltip app-guide-info-toggle__tooltip" aria-hidden="true" data-guide-info-tooltip>Show guide information</span>
    </button>
  </div>

  <div class="app-guide-info" id="guide-info" data-guide-info hidden>
    <dl class="govuk-summary-list govuk-summary-list--no-border app-guide-info__list">
      {% set infoRows = [
        ["Last modified date", currentVersion.lastUpdated if currentVersion],
        ["Scheme", metadata.scheme],
        ["Owner email", metadata.owner],
        ["Purpose of guidance", metadata.goal],
        ["Required knowledge and training", metadata.requirements],
        ["Systems", metadata.systems | join(", ")],
        ["Who is this guidance for?", metadata.audience | join(", ")]
      ] %}
      {% for row in infoRows %}
        <div class="govuk-summary-list__row">
          <dt class="govuk-summary-list__key">{{ row[0] }}</dt>
          <dd class="govuk-summary-list__value">
            {%- if not row[1] -%}
              Not provided
            {%- elif row[0] == "Owner email" -%}
              <a class="govuk-link" href="mailto:{{ row[1] }}">{{ row[1] }}</a>
            {%- else -%}
              {{ row[1] }}
            {%- endif -%}
          </dd>
        </div>
      {% endfor %}
    </dl>
  </div>

  {% if readingWidthChoice %}
    <div class="app-guide-tools">
      {% include "playground/guide/partials/reading-width.njk" %}
    </div>
  {% endif %}

  {#
    Resume reading: where this reader last was (saved as they scroll by
    guide-position.js), offered on a fresh visit rather than jumped to, so
    opening a guide stays predictable. The script hides it when the URL
    already points somewhere (#anchor).
  #}
  {% if resume %}
    <div class="govuk-inset-text app-guide-resume" data-guide-resume>
      You were last reading <strong>{{ resume.label }}</strong>.
      <a class="govuk-link" href="{{ resume.href }}">Continue reading<span class="govuk-visually-hidden"> from {{ resume.label }}</span></a>
    </div>
  {% endif %}

  {% if isApiGuide and not content.sections %}
    {#
      An API guide with no headings to split on has no
      sections/parts/stepper model to walk — content.html is the whole
      guide, already rendered from its content.md by marked
      (guide/guide-content.js's buildMarkdownGuideContent), so it's just
      dropped in directly rather than through reading-content.njk's
      section/part/pagination markup.
    #}
    {% if content.contents.length %}
      <nav class="app-guide-contents" id="guide-contents" aria-labelledby="guide-contents-heading" data-guide-toc>
        {{ guideTools | safe }}
        <h2 class="govuk-heading-s" id="guide-contents-heading">Contents</h2>
        <ul class="govuk-list app-guide-contents__list app-guide-contents__list--flat">
          {% for heading in content.contents %}
            <li class="app-guide-contents__item--depth-{{ heading.depth }}"><a class="govuk-link app-guide-contents__link" href="#{{ heading.id }}" data-guide-toc-target="{{ heading.id }}">{{ heading.text }}</a></li>
          {% endfor %}
        </ul>
      </nav>
    {% else %}
      {# No contents column to hold them: the tools sit above the guide. #}
      <div class="app-guide-tools-inline">{{ guideTools | safe }}</div>
    {% endif %}
    <div class="app-guide-markdown">{{ content.html | safe }}</div>
  {% else %}
    {% include "playground/guide/partials/reading-content.njk" %}
  {% endif %}

  </div>

</div>

{% if not sideNav %}{{ guideComments | safe }}{% endif %}

{#
  The sharing link in the guide's left margin: guide-share-link.js moves it
  beside whichever element the pointer is over, and a click copies a link
  to that place (guide/section/, with a text fragment).
#}
<button type="button" class="app-guide-share-link" data-guide-share-link data-section-href="/playground/guide/{{ document.id | urlencode }}/section/" hidden>
  {{ sideNavIcon("link") }}
  <span class="govuk-visually-hidden" data-guide-share-link-name>Click to copy sharing link</span>
  <span class="app-side-nav__tooltip app-guide-share-link__tooltip" aria-hidden="true" data-guide-share-link-tooltip>Click to copy sharing link</span>
</button>
<p class="govuk-visually-hidden" role="status" data-guide-share-link-status></p>

{% endblock %}

{% block shellAside %}{% if sideNav %}{{ guideComments | safe }}{% endif %}{% endblock %}

{% block pageScripts %}
  {% if publishingChecksInNav %}<script src="/public/javascripts/guide-publishing-checks.js"></script>{% endif %}
  {% if isMarkdown %}<script src="/public/javascripts/vendor/tiptap-viewer.js"></script>{% endif %}
  {% if isMarkdown %}<script src="/public/javascripts/guide-links.js"></script>{% endif %}
  <script src="/public/javascripts/guide-images.js"></script>
  {% if stepperPages %}<script src="/public/javascripts/guide-pages.js"></script>{% endif %}
  <script src="/public/javascripts/keyword-matches.js"></script>
  <script src="/public/javascripts/guide-keyword-search.js"></script>
  {# Marks the one contents entry for where the reader is, or the current match. #}
  <script src="/public/javascripts/guide-toc.js"></script>
  {% if positionHref %}<script src="/public/javascripts/guide-position.js"></script>{% endif %}
  <script src="/public/javascripts/guide-info.js"></script>
  <script src="/public/javascripts/guide-share-link.js"></script>
  {% if isEditor and editorActions.qualityCheckHref %}<script src="/public/javascripts/guide-comments.js"></script>{% endif %}
{% endblock %}
