{#
  Designer-only list of pending "Request permission to edit" requests, with
  an Approve button each. Approval is temporary edit access for the rest of
  the session (data/permissions.js). Reached from the side nav's Designing
  section.
#}
{% extends "common/layouts/content.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}

{% set pageName = "Edit requests" %}

{% block content %}
  <h1 class="govuk-heading-l">Edit requests</h1>

  {% if requests.length %}
    <p class="govuk-body">Approving gives that person temporary access to edit the guide.</p>
    <table class="govuk-table">
      <caption class="govuk-table__caption govuk-visually-hidden">Pending requests to edit a guide</caption>
      <thead class="govuk-table__head">
        <tr class="govuk-table__row">
          <th scope="col" class="govuk-table__header">Guide</th>
          <th scope="col" class="govuk-table__header"><span class="govuk-visually-hidden">Action</span></th>
        </tr>
      </thead>
      <tbody class="govuk-table__body">
        {% for request in requests %}
          <tr class="govuk-table__row">
            <td class="govuk-table__cell"><a class="govuk-link" href="{{ request.guideHref }}">{{ request.title }}</a></td>
            <td class="govuk-table__cell">
              <form method="post" action="{{ request.approveHref }}">
                {{ govukButton({
                  text: "Approve",
                  attributes: { "aria-label": "Approve edit access for " + request.title },
                  classes: "govuk-button--secondary govuk-!-margin-bottom-0"
                }) }}
              </form>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% else %}
    <p class="govuk-body">There are no pending requests to edit a guide.</p>
  {% endif %}
{% endblock %}
