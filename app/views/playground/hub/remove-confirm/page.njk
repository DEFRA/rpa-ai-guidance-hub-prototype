{#
  Confirms removing a row from any of the hub's three removable tabs
  (Recently opened, Saved guidance, Editing — Awaiting approval has no
  Remove action). Merges what were two separate confirm pages
  (/v6/find-guidance/remove-confirm and /v6/manage-guidance/remove-confirm)
  into one: the two only ever differed in which session list ?tab= names
  and which POST route that implied, both now handled by controller.js's
  own getRemoveConfirm/postRemove reading tab uniformly.
#}
{% extends "common/layouts/base.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/breadcrumbs/macro.njk" import govukBreadcrumbs %}

{% set pageName = "Are you sure you want to remove this guidance?" %}

{% block content %}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-full">
    {{ govukBreadcrumbs({
      classes: "govuk-!-margin-bottom-6",
      items: [
        { text: "Home", href: "/playground/hub" },
        { text: pageName }
      ]
    }) }}
  </div>
</div>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    <h1 class="govuk-heading-l">Are you sure you want to remove this guidance?</h1>

    {% if documentTitle and listName %}
      <p class="govuk-body govuk-!-font-weight-bold">You are about to remove '{{ documentTitle }}' from your {{ listName }} list.</p>
    {% else %}
      <p class="govuk-body govuk-!-font-weight-bold">You are about to remove this guidance.</p>
    {% endif %}

    <form method="post" action="/playground/hub/remove">
      <input type="hidden" name="id" value="{{ documentId }}">
      <input type="hidden" name="tab" value="{{ tabParam }}">
      <div class="govuk-button-group">
        {{ govukButton({
          text: "Yes, remove",
          classes: "govuk-button--warning"
        }) }}
        {{ govukButton({
          text: "Cancel",
          href: "/playground/hub?tab=" + tabParam,
          classes: "govuk-button--secondary"
        }) }}
      </div>
    </form>

  </div>
</div>

{% endblock %}
