{#
  The check page before converting. The details are grouped into summary
  cards, one per step, each carrying a single "Change" in its header that
  opens the step that owns those fields with ?from=check, so that step's
  Continue (and back link) returns straight here rather than carrying on
  through the rest of the flow (see controller.js). Converting leads to the
  success page; no quality checks run at this stage.

  Consolidation fix: the "Type of guidance" row this page used to show
  (always "Process guide") is dropped — it was never asked anywhere
  upstream in the metadata steps, just a hardcoded value with no question
  behind it (see controller.js's own uploadedGuide default). The
  consolidation plan flagged this as an open question ("missing question,
  or dead content?"); since nothing in the journey collects a real answer
  for it, removing the row is the honest fix rather than inventing a new
  question this flow was never asked to add.
#}
{% extends "common/layouts/content.njk" %}

{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% set pageName = "Check the details before converting" %}

{# ?from=check tells the step it was opened from here, so it hands the flag
   back on submit and Continue returns straight to this page instead of
   carrying on through the rest of the flow. #}
{% set detailsChange = "/consolidated/upload/details?from=check" %}
{% set purposeChange = "/consolidated/upload/owner?from=check" %}

{% block columns %}

  <h1 class="govuk-heading-l">Check the details before you convert</h1>

  {{ govukSummaryList({
    card: {
      title: { text: "The guide's details" },
      actions: { items: [{ href: detailsChange, text: "Change", visuallyHiddenText: "the guide's details" }] }
    },
    rows: [
      {
        key: { text: "File" },
        value: { text: details.name + ".docx" },
        actions: { items: [{ href: "/consolidated/upload", text: "Change", visuallyHiddenText: "the uploaded file" }] }
      },
      { key: { text: "Guidance title" }, value: { text: details.name } },
      { key: { text: "Version number" }, value: { text: details.version } },
      { key: { text: "Last modified date" }, value: { text: details.lastModified } },
      { key: { text: "Scheme" }, value: { text: schemeLabel } }
    ]
  }) }}

  {{ govukSummaryList({
    card: {
      title: { text: "Owner and purpose" },
      actions: { items: [{ href: purposeChange, text: "Change", visuallyHiddenText: "the owner and purpose" }] }
    },
    rows: [
      { key: { text: "Owner email" }, value: { text: details.owner or "Not provided" } },
      { key: { text: "Purpose of guidance" }, value: { text: details.goal or "Not provided" } },
      { key: { text: "Required knowledge and training" }, value: { text: details.requirements or "Not provided" } },
      { key: { text: "Systems" }, value: { text: systemsLabel } },
      { key: { text: "Who is this guidance for?" }, value: { text: audienceLabel } }
    ]
  }) }}

  <p class="govuk-body">
    When you convert this document, it is saved as a draft that only you can
    see until it is reviewed and published.
  </p>

  <form method="post" action="/consolidated/upload/check">
    {{ govukButton({ text: "Convert document" }) }}
  </form>

{% endblock %}
