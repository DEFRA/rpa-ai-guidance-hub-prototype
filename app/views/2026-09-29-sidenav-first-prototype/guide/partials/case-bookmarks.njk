{#
  The panel's "Case bookmarks" section — a list of the cases this guide is
  already bookmarked to (each removable in place) plus a button through to
  the bookmark/ question page. Sits first in the panel body (page.njk), not
  after the metadata: it's the one task in the panel, everything else is
  read-once reference. Reads `caseBookmarks` (guide/view-model.js's
  buildCaseBookmarks). Styled after the side nav's own Case bookmarks
  section (partials/side-nav.njk) rather than the old boxed
  partials/bookmark-form.njk.
#}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "partials/side-nav-icon.njk" import sideNavIcon %}

<section class="app-guide-panel__section" id="guide-case-bookmarks" aria-labelledby="guide-case-bookmarks-heading">
  <h2 class="app-side-nav__label" id="guide-case-bookmarks-heading">Case bookmarks</h2>

  {% if caseBookmarks.items.length %}
    <ul class="govuk-list app-guide-panel__bookmarks-list">
      {% for bookmark in caseBookmarks.items %}
        <li class="app-guide-panel__bookmarks-item">
          <a class="govuk-link app-guide-panel__bookmarks-link" href="{{ bookmark.href }}">
            <span class="app-side-nav__ref-type">{{ bookmark.typeLabel }}</span>
            {{ bookmark.ref }}
          </a>
          <form method="post" action="{{ bookmark.removeHref }}">
            <input type="hidden" name="type" value="{{ bookmark.type }}">
            <input type="hidden" name="ref" value="{{ bookmark.ref }}">
            <input type="hidden" name="documentId" value="{{ id }}">
            <input type="hidden" name="returnTo" value="{{ returnTo }}#guide-case-bookmarks">
            <button type="submit" class="govuk-link app-link-button govuk-body-s">Remove<span class="govuk-visually-hidden"> {{ bookmark.typeLabel }} {{ bookmark.ref }} from case bookmarks</span></button>
          </form>
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p class="app-side-nav__empty">Not bookmarked to any cases yet.</p>
  {% endif %}

  {{ govukButton({
    text: "Bookmark to a case",
    href: caseBookmarks.bookmarkHref,
    classes: "govuk-button--secondary govuk-!-margin-bottom-0"
  }) }}
</section>
