{
  "name": "rpa-ai-guidance-hub-prototype",
  "version": "0.1.0",
  "description": "rpa-ai-guidance-hub-prototype. GOV.UK Prototype Kit with CDP Platform running capabilities",
  "author": "Defra DDTS",
  "license": "(OGL-UK-3, MIT) see licenses in /LICENSES",
  "scripts": {
    "dev": "govuk-prototype-kit dev",
    "serve": "govuk-prototype-kit serve",
    "start": "govuk-prototype-kit start",
    "format": "prettier --write \"**/*.{cjs,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{cjs,js,json,md}\"",
    "snapshot": "node scripts/snapshot.js",
    "check:frozen": "node scripts/check-frozen.js",
    "build:tiptap": "node scripts/tiptap-viewer/build.js",
    "update:vendor": "node scripts/update-vendor.js"
  },
  "dependencies": {
    "@govuk-prototype-kit/common-templates": "3.0.1",
    "govuk-frontend": "6.5.1",
    "govuk-prototype-kit": "13.20.5",
    "marked": "18.0.14"
  },
  "devDependencies": {
    "@tiptap/core": "3.29.2",
    "@tiptap/extension-highlight": "3.29.2",
    "@tiptap/extension-image": "3.29.2",
    "@tiptap/extension-table": "3.29.2",
    "@tiptap/extension-text-style": "3.29.2",
    "@tiptap/markdown": "3.29.2",
    "@tiptap/pm": "3.29.2",
    "@tiptap/starter-kit": "3.29.2",
    "accessible-autocomplete": "3.0.1",
    "esbuild": "0.28.2",
    "material-symbols": "0.47.5",
    "prettier": "3.9.8"
  }
}
